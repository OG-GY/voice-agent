# Copy to .env for local development. Never commit .env. Nothing here is a real secret.

APP_ENV=development            # development | test | production
BIND_HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | text
EXPOSE_DEBUG_TRACE=true        # development only: lets the UI show the normalized text
# LOG_TRANSCRIPTS=false        # development only; refused in production
# BRAIN_FIXED_NOW=2026-10-30 18:00   # demo only: freezes the clock; refused in production

CORS_ORIGINS=http://localhost:3000   # comma separated; production needs https:// origins
# TRUSTED_PROXIES=                   # reverse proxy addresses allowed to set X-Forwarded-*
# CALLER_KEY_SECRET=                 # production: 32+ random characters (hashes client IPs)

# Bookings (SQLite file; the folder is git-ignored)
REPOSITORY_BACKEND=sqlite      # sqlite | memory (memory is for tests only)
DATABASE_PATH=data/copper_pot.db
SEED_DEMO_DATA=true            # development only: loads the fake demo bookings

# Speech to text (faster-whisper)
STT_ENABLED=true
STT_MODEL=base.en
# STT_MODEL_PATH=models/base.en      # production: a folder prepared with app.speech.download_model
STT_ALLOW_DOWNLOAD=true            # production: false
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Limits (defaults are fine for one small machine; see plans/backend/api-plan.md section 9)
# MAX_CONCURRENT_CALLS=10
# STT_QUEUE_MAX=4
# STT_TIMEOUT_SECONDS=15
